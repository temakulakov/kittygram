    "name": "Kittygram API",
    "description": "Проверочные запросы к Kittygram: пользователи, котики и кото-встречи с лимитом мест. Запросы выполняются по порядку: токены и id сохраняются в переменные коллекции.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Пользователи и токены",
      "item": [
        {
          "name": "Регистрация пользователя A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                ""
              ]
            },
            "description": "Djoser: создание пользователя. Логин генерируется, чтобы коллекцию можно было запускать повторно.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{alice}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"alice\", \"alice_\" + Date.now());",
                  "pm.collectionVariables.set(\"bob\", \"bob_\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"В ответе есть id и username\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.property(\"id\");",
                  "  pm.expect(j.username).to.eql(pm.collectionVariables.get(\"alice\"));",
                  "});"
                ]
              }
            }
          ]
        },
