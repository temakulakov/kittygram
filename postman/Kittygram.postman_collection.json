        {
          "name": "Создать встречу (1 место)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Token {{token_organizer}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                ""
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Кото-сходка на Плехановской\",\n  \"description\": \"Знакомимся, играем, фотографируемся\",\n  \"city\": \"Москва\",\n  \"address\": \"Стремянный пер., 36\",\n  \"starts_at\": \"{{starts_at}}\",\n  \"ends_at\": \"{{ends_at}}\",\n  \"capacity\": 1,\n  \"max_cats_per_user\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
