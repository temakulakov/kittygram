              "raw": "{\n  \"name\": \"Пушок\",\n  \"color\": \"#000000\",\n  \"birth_year\": 2021,\n  \"achievements\": [\n    {\n      \"achievement_name\": \"Поймал лазерную точку\"\n    }\n  ]\n}",
